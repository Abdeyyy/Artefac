# Port server
PORT=5000

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/artefac_db?retryWrites=true&w=majority

# Throttling snapshot telemetri (dalam milidetik, 60000 = 1 menit)
TELEMETRY_SNAPSHOT_INTERVAL=60000

# Mosquitto MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_TOPIC=artefac/simpang/artos/telemetry
